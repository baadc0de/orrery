[package]
name = "orrery-wire-vector-generator"
version = "0.0.0"
edition = "2021"
publish = false

[dependencies]
blake3 = "=1.8.6"
hmac = "=0.12.1"
iroh-base = { version = "=1.0.3", default-features = false, features = ["key"] }
orrery_protocol = { path = "@ORRERY_PROTOCOL_PATH@" }
postcard = { version = "=1.1.3", default-features = false, features = ["use-std"] }
rand_chacha = "=0.9.0"
serde = "=1.0.229"
serde_json = "=1.0.151"
sha2 = "=0.10.9"
